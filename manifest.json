{
  "manifest_version": 3,
  "name": "autologin",
  "version": "5.8",
  "description": "Identifica a interface do roteador e ajuda no login.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}